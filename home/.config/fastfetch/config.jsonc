{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "color": { "1": "default" },
    "source": "/home/soqu/.config/fastfetch/logo.txt",
    "width": 20,
    "padding": { "top": 1, "right": 4 }
  },
  "display": {
    "color": { "keys": "white", "title": "white" },
    "percent": { "type": 9 }
  },
  "modules": [
    "break",
    { "type": "os", "key": "  os" },
    { "type": "kernel", "key": "  kern" },
    { "type": "packages", "key": "  pkgs" },
    { "type": "shell", "key": "  sh" },
    { "type": "wm", "key": "  wm" },
    { "type": "uptime", "key": "  up" },
    { "type": "memory", "key": "  mem" }
  ]
}
